rules_version = '2';

// Regras de segurança do Firestore para o sistema do depósito.
// Só quem fez login (usuários criados em Authentication) pode ler e gravar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
